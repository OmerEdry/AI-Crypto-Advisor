    "prettier": "^3.0.0",
    "prisma": "6.19.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.3",
