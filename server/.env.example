NODE_ENV=development
PORT=4000

# Both URLs point at the SAME database and differ only in endpoint (see ARCHITECTURE.md §15.1).
# POOLED — hostname contains "-pooler". Used by the application at runtime.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15
# DIRECT — same host WITHOUT "-pooler". Used by prisma migrate.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15

# >=32 chars, generated, never reused
JWT_SECRET=
# one of: 15m | 1h | 1d | 7d | 30d — anything else fails at boot
JWT_EXPIRES_IN=7d
COOKIE_NAME=cca_token
CORS_ORIGINS=http://localhost:5173

# free Demo key
COINGECKO_API_KEY=
# INTENTIONALLY EMPTY — the static feed serves news (ARCHITECTURE.md §9.2a)
CRYPTOPANIC_TOKEN=
OPENROUTER_API_KEY=
# env-driven: free model IDs rotate
LLM_MODEL=
LLM_ENABLED=true

CACHE_TTL_PRICES_MS=120000
CACHE_TTL_NEWS_MS=600000
